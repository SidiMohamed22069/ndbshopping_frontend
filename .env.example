# Appelé côté serveur (Django → Spring Boot).
# En local (backend déjà en ligne) : https://ndbshopping.duckdns.org/api
# En production Docker (même réseau) : http://backend:8080/api
API_BASE_URL=http://backend:8080/api

# URLs d'images construites dans les templates (domaine PUBLIC, jamais l'IP interne Docker)
MEDIA_BACKEND_URL=https://ndbshopping.duckdns.org/media

# Utilisé UNIQUEMENT par le JS du navigateur pour le WebSocket STOMP.
# Doit être un hôte public (ndbshopping.duckdns.org) — PAS le nom du conteneur.
PUBLIC_BACKEND_HOST=ndbshopping.duckdns.org

DJANGO_SECRET_KEY=changeme_generez_une_vraie_cle
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=ndbshopping.duckdns.org,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://ndbshopping.duckdns.org,http://localhost:8000
# False en local (HTTP). True en production HTTPS.
DJANGO_COOKIE_SECURE=False
